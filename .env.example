# MediSphere AI Backend Environment Configuration

# Database Connection (Default: SQLite persistent relational database)
# To use SQLite (default):
DATABASE_URL=sqlite:///./medisphere.db

# To use PostgreSQL (optional):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/medisphere

# To use MySQL (optional):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medisphere

# JWT Secret Key for Session Authentication
JWT_SECRET_KEY=medisphere-secret-jwt-key-hackathon-2026-very-secure

# Optional LLM API Provider (OpenAI / Gemini)
# If omitted, MediSphere AI uses its built-in clinical rule engine
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
